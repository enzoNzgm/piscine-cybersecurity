FROM debian:bookworm-slim

LABEL description="Inquisitor FTP server (vsftpd)"

RUN apt-get update && apt-get install -y --no-install-recommends \
        vsftpd \
    && rm -rf /var/lib/apt/lists/*

# Required by vsftpd secure_chroot_dir
RUN mkdir -p /var/run/vsftpd/empty

# Create FTP user and sample files
RUN useradd -m ftpuser && echo "ftpuser:ftppass" | chpasswd
RUN mkdir -p /home/ftpuser/files && \
    echo "Secret file content" > /home/ftpuser/files/secret.txt && \
    echo "Another file"        > /home/ftpuser/files/data.csv  && \
    chown -R ftpuser:ftpuser /home/ftpuser

# vsftpd configuration
COPY vsftpd.conf /etc/vsftpd.conf

EXPOSE 21

CMD ["vsftpd", "/etc/vsftpd.conf"]
